# ---- Dependencies (like PHP vendor/) ----
node_modules/
react-app/node_modules/
functions/*/node_modules/

# ---- Build output (regenerated by `npm run build`) ----
react-app/dist/
.build/

# ---- Catalyst logs ----
catalyst-debug.log

# ---- Secrets (never commit, like db passwords) ----
.env
.env.*
!.env.example
functions/*/.env

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
